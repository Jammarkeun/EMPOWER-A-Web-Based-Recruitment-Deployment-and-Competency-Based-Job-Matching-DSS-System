# ===========================================================================
# EMPOWER - environment configuration
# ===========================================================================
#
# Copy this file to .env and fill in the marked values, then run:
#
#     php artisan key:generate
#
# The blanks below are credentials for the team's Supabase project. They are
# deliberately NOT in this repository and must never be committed. Ask a
# teammate to send them privately - by direct message, not in a group chat and
# not in the repository - or create your own Supabase project and use its
# values instead.
#
# Everything already filled in works as-is for local development.
# ===========================================================================

APP_NAME=EMPOWER
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=Asia/Manila

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_PH

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ---------------------------------------------------------------------------
# Database - Supabase PostgreSQL
# ---------------------------------------------------------------------------
# Supabase dashboard -> Project Settings -> Database -> Connection string,
# and choose "Session pooler".
#
# Use the SESSION pooler on port 5432, not the Transaction pooler on 6543.
# The transaction pooler does not support prepared statements, which Laravel's
# migrations rely on, and the failure it produces is not obvious.
#
# DB_HOST and DB_USERNAME both contain the project reference, so they differ
# per project - copy them from the dashboard rather than guessing.
DB_CONNECTION=pgsql
DB_HOST=aws-0-ap-southeast-1.pooler.supabase.com
DB_PORT=5432
DB_DATABASE=postgres
DB_USERNAME=postgres.your-project-ref
DB_PASSWORD=
DB_SSLMODE=require

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
QUEUE_CONNECTION=database
CACHE_STORE=database

# ---------------------------------------------------------------------------
# File storage - Supabase Storage, through its S3-compatible endpoint
# ---------------------------------------------------------------------------
# Create the key pair at: Project Settings -> Storage -> S3 Access Keys.
# The bucket must exist and must be PRIVATE - applicant documents are reached
# only through short-lived signed URLs, never a public path.
FILESYSTEM_DISK=supabase
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_S3_ENDPOINT=https://your-project-ref.storage.supabase.co/storage/v1/s3
SUPABASE_S3_REGION=ap-southeast-1
SUPABASE_S3_BUCKET=applicant-documents
SUPABASE_S3_ACCESS_KEY_ID=
SUPABASE_S3_SECRET_ACCESS_KEY=

# Used only for administrative Storage operations the S3 protocol does not
# cover, such as creating the bucket. Never expose this to the frontend.
SUPABASE_SERVICE_ROLE_KEY=

# How long a document download link stays valid, in minutes.
SUPABASE_SIGNED_URL_TTL=10

# ---------------------------------------------------------------------------
# Document reading service (FastAPI + PaddleOCR) - optional
# ---------------------------------------------------------------------------
# The system runs without this; document reading is simply unavailable and the
# scan button is hidden. To use it, run backend/ocr_service and set the same
# token in BOTH places - here, and in the service's OCR_SERVICE_TOKEN.
#
# Recognition is slow by design: oneDNN must stay disabled for PaddlePaddle 3.x
# to work at all, so allow roughly 40 seconds per page.
OCR_SERVICE_URL=http://127.0.0.1:8001
OCR_SERVICE_TIMEOUT=120
OCR_SERVICE_TOKEN=empower-dev-token

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="noreply@cdemanpower.local"
MAIL_FROM_NAME="${APP_NAME}"

# ---------------------------------------------------------------------------
# Frontend
# ---------------------------------------------------------------------------
# The origin allowed to call the API. Change only if Vite serves on a
# different port.
FRONTEND_URL=http://localhost:5173
SANCTUM_STATEFUL_DOMAINS=localhost:5173,127.0.0.1:5173

VITE_APP_NAME="${APP_NAME}"
