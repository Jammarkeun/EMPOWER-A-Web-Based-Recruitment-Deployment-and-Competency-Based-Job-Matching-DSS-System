# ===========================================================================
# EMPOWER - environment configuration
# ===========================================================================
#
# Copy this file to .env and fill in the marked values, then run:
#
#     php artisan key:generate
#
# The blanks below are credentials for the team's Supabase project. They are
# deliberately NOT in this repository and must never be committed. Ask a
# teammate to send them privately - by direct message, not in a group chat and
# not in the repository - or create your own Supabase project and use its
# values instead.
#
# Everything already filled in works as-is for local development.
# ===========================================================================

APP_NAME=EMPOWER
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=Asia/Manila

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_PH

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ---------------------------------------------------------------------------
# Database - two platforms, switched by one line
# ---------------------------------------------------------------------------
#
#   mysql  local XAMPP. Used for development and demonstrations because it is
#          fast: the dashboard loads in well under a second.
#   pgsql  Supabase. The platform for the final defense. Correct, but every
#          query is a round trip to Singapore at roughly 117ms, so the same
#          dashboard takes several seconds.
#
# Both are configured below at the same time, so switching is only this line.
# Nothing else needs editing and neither set of settings is lost.
DB_CONNECTION=mysql

# --- local XAMPP (demo) ----------------------------------------------------
# Defaults are XAMPP out of the box. Create the database once with:
#     CREATE DATABASE empower CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=empower
MYSQL_USERNAME=root
MYSQL_PASSWORD=

# --- Supabase (final defense) ----------------------------------------------
# Dashboard -> Project Settings -> Database -> Connection string -> Session pooler.
# Use the SESSION pooler on 5432, never the transaction pooler on 6543: that one
# has no prepared statements, which the migrations rely on.
PGSQL_HOST=aws-0-ap-southeast-1.pooler.supabase.com
PGSQL_PORT=5432
PGSQL_DATABASE=postgres
PGSQL_USERNAME=postgres.your-project-ref
PGSQL_PASSWORD=
DB_SSLMODE=require

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
QUEUE_CONNECTION=database
CACHE_STORE=database

# ---------------------------------------------------------------------------
# File storage - Supabase Storage, through its S3-compatible endpoint
# ---------------------------------------------------------------------------
# Create the key pair at: Project Settings -> Storage -> S3 Access Keys.
# The bucket must exist and must be PRIVATE - applicant documents are reached
# only through short-lived signed URLs, never a public path.
FILESYSTEM_DISK=supabase
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_S3_ENDPOINT=https://your-project-ref.storage.supabase.co/storage/v1/s3
SUPABASE_S3_REGION=ap-southeast-1
SUPABASE_S3_BUCKET=applicant-documents
SUPABASE_S3_ACCESS_KEY_ID=
SUPABASE_S3_SECRET_ACCESS_KEY=

# There is deliberately no SUPABASE_SERVICE_ROLE_KEY (security audit V-04).
# Nothing in EMPOWER uses it, and it bypasses every row-level security rule in
# the project, so a copy of .env holding it would be a key to the whole
# database. Create the bucket in the Supabase dashboard instead.

# How long a document download link stays valid, in minutes.
SUPABASE_SIGNED_URL_TTL=10

# Where applicant documents, violation evidence and profile photos are kept.
# It must be a PRIVATE disk; the application refuses to store or open files on
# a public one.
#   supabase   the private Supabase bucket above (defence / deployment)
#   documents  storage/app/private/documents on this machine, opened only
#              through links signed for SUPABASE_SIGNED_URL_TTL minutes
# Never "public": anything on that disk can be opened by anybody, for ever.
# To move files that are already on another disk (keys stay the same):
#   php artisan empower:move-documents --from=public --to=documents
#   ...check a document opens, then run it again with --delete-source
DOCUMENT_DISK=supabase

# ---------------------------------------------------------------------------
# Document reading service (FastAPI + PaddleOCR) - optional
# ---------------------------------------------------------------------------
# The system runs without this; document reading is simply unavailable and the
# scan button is hidden. To use it, run backend/ocr_service and set the same
# token in BOTH places - here, and in the service's OCR_SERVICE_TOKEN.
#
# Recognition is slow by design: oneDNN must stay disabled for PaddlePaddle 3.x
# to work at all, so allow roughly 40 seconds per page.
OCR_SERVICE_URL=http://127.0.0.1:8001
OCR_SERVICE_TIMEOUT=120
OCR_SERVICE_TOKEN=empower-dev-token

# ---------------------------------------------------------------------------
# Mail and password recovery
# ---------------------------------------------------------------------------
# "log" writes mail to storage/logs instead of sending it. That is fine for
# development, and it is why the emailed reset link below stays off with it:
# a reset link in a log file is a live credential anybody reading the log
# could use.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="noreply@cdemanpower.local"
MAIL_FROM_NAME="${APP_NAME}"

# Lets people reset a forgotten password by an emailed link (single use,
# expires after 60 minutes). Takes effect only with a real mailer above, e.g.
#   MAIL_MAILER=smtp  MAIL_HOST=...  MAIL_PORT=587  MAIL_USERNAME=...  MAIL_PASSWORD=...
# The link is sent just after the request is answered, by the same process; no
# queue worker is involved. Without this, the "Forgot your password?" page
# sends people to the office, which issues a temporary password they must
# replace when they sign in.
PASSWORD_RESET_EMAIL=false

# ---------------------------------------------------------------------------
# Frontend
# ---------------------------------------------------------------------------
# The origin allowed to call the API. Change only if Vite serves on a
# different port.
FRONTEND_URL=http://localhost:5173
SANCTUM_STATEFUL_DOMAINS=localhost:5173,127.0.0.1:5173

# How long a sign-in lasts, in minutes (security audit V-02). Both values are
# provisional until CDE answers client question 20.4. Empty uses the default
# shown; 0 turns that limit off.
#   SANCTUM_EXPIRATION   - from signing in, however active (default 720 = 12 h)
#   SANCTUM_IDLE_TIMEOUT - since the account last did anything (default 60)
# The screen warns two minutes before an idle sign-out. After changing either,
# run `php artisan config:clear` if the config has been cached.
SANCTUM_EXPIRATION=720
SANCTUM_IDLE_TIMEOUT=60

# Request limits on the public endpoints, per network address (everyone in one
# office usually shares one). Each has its own counter. The defaults are shown;
# see config/empower.php for the others. Wrong passwords keep their own stricter
# limit per account (5 per 5 minutes), which these do not change.
#RATE_LIMIT_LOGIN_PER_MINUTE=30
#RATE_LIMIT_REGISTRATIONS_PER_HOUR=10
#RATE_LIMIT_REGISTRATION_ATTEMPTS_PER_HOUR=30

VITE_APP_NAME="${APP_NAME}"
