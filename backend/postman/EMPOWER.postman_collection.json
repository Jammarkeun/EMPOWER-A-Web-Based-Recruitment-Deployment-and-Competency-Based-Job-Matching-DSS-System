    {
      "name": "Job Requests",
      "item": [
        {
          "name": "Create Job Request",
          "request": {
            "method": "POST",
            "header": [
              {"key": "Authorization", "value": "Bearer {{token}}"},
              {"key": "Content-Type", "value": "application/json"}
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"client_company_id\": 1,\n  \"client_department_id\": 1,\n  \"position_title\": \"Production Helper\",\n  \"required_education\": \"High School Graduate\",\n  \"required_experience_months\": 6,\n  \"required_certifications\": [\"NC II\"],\n  \"gender_preference\": \"any\",\n  \"age_min\": 18,\n  \"age_max\": 35,\n  \"height_min_cm\": 152,\n  \"physical_requirement\": \"Fit to lift 15kg\",\n  \"availability_requirement\": \"Can start within 7 days\",\n  \"workers_needed\": 15,\n  \"date_requested\": \"2026-08-04\",\n  \"deployment_deadline\": \"2026-08-20\",\n  \"request_source\": \"email\"\n}"
            },
            "url": "{{baseUrl}}/api/v1/job-requests"
          }
        },
        {
          "name": "Run Matching Evaluation",
          "request": {
            "method": "POST",
            "header": [
              {"key": "Authorization", "value": "Bearer {{token}}"},
              {"key": "Content-Type", "value": "application/json"}
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"candidate_scope\": \"ready_for_deployment\",\n  \"limit\": 100\n}"
            },
            "url": "{{baseUrl}}/api/v1/job-requests/1/evaluate"
          }
        }
        {
          "name": "Evaluate with Arrays (sample)",
          "request": {
            "method": "POST",
            "header": [
              {"key": "Authorization", "value": "Bearer {{token}}"},
              {"key": "Content-Type", "value": "application/json"}
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"criteria\": [\n    { \"code\": \"education\", \"type\": \"weighted_binary\", \"weight\": 15, \"expected\": \"high_school_or_above\" },\n    { \"code\": \"experience\", \"type\": \"weighted_scale\", \"weight\": 20, \"min\": 6, \"max\": 60 },\n    { \"code\": \"certifications\", \"type\": \"hard_filter\", \"weight\": 10, \"expected\": \"NC II\" },\n    { \"code\": \"distance\", \"type\": \"weighted_scale\", \"weight\": 5, \"min\": 0, \"max\": 50 },\n    { \"code\": \"availability\", \"type\": \"weighted_binary\", \"weight\": 15, \"expected\": \"within_7_days\" },\n    { \"code\": \"communication\", \"type\": \"weighted_rubric\", \"weight\": 20, \"rubric\": { \"excellent\": 1.0, \"good\": 0.8, \"fair\": 0.5, \"poor\": 0.2 } },\n    { \"code\": \"reliability\", \"type\": \"weighted_rubric\", \"weight\": 15, \"rubric\": { \"excellent\": 1.0, \"good\": 0.8, \"fair\": 0.5, \"poor\": 0.2 } }\n  ],\n  \"applicants\": [\n    {\n      \"id\": 501,\n      \"name\": \"Maria Santos\",\n      \"education_level\": \"high_school_or_above\",\n      \"months_experience\": 24,\n      \"certifications\": [\"NC II\"],\n      \"distance_km\": 8.5,\n      \"availability\": \"within_7_days\",\n      \"communication_rating\": \"good\",\n      \"reliability_rating\": \"excellent\",\n      \"application_date\": \"2026-07-28\"\n    }\n  ]\n}"
            },
            "url": "{{baseUrl}}/api/v1/job-requests/1/evaluate"
          }
        },
      ]
